# Flawtrace Cloud settings. Copy this file to .env on the server and fill it in. NEVER commit .env.
# Step by step: docs/RELEASE-CHECKLIST.md

# ---------- Addresses ----------
# Two host names, both pointing (DNS A record) at your server. The first is the public site, the second is the product.
SITE_HOST=flawtrace.example
APP_HOST=app.flawtrace.example
# An address Let's Encrypt can write to if a certificate cannot be renewed.
ACME_EMAIL=you@flawtrace.example

# ---------- Secrets (generate each one with: openssl rand -hex 32) ----------
# Derives every customer's own encryption key. If you lose it, saved tokens and AI keys cannot be read any more.
# Back it up somewhere that is NOT the same place as the data backups.
CLOUD_MASTER_SECRET=

# ---------- Who you are (shown on the legal pages; the server refuses to start in production while these are placeholders) ----------
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_ID=
CONTACT_EMAIL=
GOVERNING_LAW=
HOSTING_PROVIDER=
HOSTING_REGION=
# How many days backups are kept (also stated on the legal pages).
BACKUP_DAYS=35

# ---------- E-mail (Resend: https://resend.com, free tier is enough to start) ----------
RESEND_API_KEY=
MAIL_FROM=Flawtrace <no-reply@flawtrace.example>

# ---------- Billing (Stripe). Leave STRIPE_SECRET_KEY empty for a free closed beta: nobody is asked for a card ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring Stripe price per billing period (price_...). A period without an id is not offered.
# STRIPE_PRICE_ID still works as the monthly price.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_ANNUAL=
# The price list shown on the site and checked against Stripe (a mismatch blocks that period at checkout).
PRICE_CURRENCY=USD
PRICE_MONTHLY=15
PRICE_SEMIANNUAL=78
PRICE_ANNUAL=144
# Enterprise card on the pricing page (sold by invoice, activated with: node cloud/admin.js enterprise <email> <seats> <months>)
ENTERPRISE_FROM_MONTHLY=99
ENTERPRISE_SEATS=25
# Set to 1 once Stripe Tax is switched on in your Stripe account.
STRIPE_TAX=0
# Optional text for the price in the terms. Empty = built from the price list: $15 per month, $78 every 6 months or $144 per year
PRICE_LABEL=

# ---------- Access ----------
# Closed beta: when set, nobody can sign up without this code (invited colleagues do not need it).
BETA_CODE=
TRIAL_DAYS=14
# 1 = the trial starts only after a payment method is added in Stripe Checkout (first charge when the trial ends).
# 0 = the trial needs no card; the checkout is offered during the trial and required after it. TRIAL_DAYS=0: pay first.
TRIAL_REQUIRES_CARD=0
# Plan name on the checkout page.
PLAN_NAME=Team workspace
MAX_SEATS=5
# Addresses that are treated as operators of the service (space or comma separated).
ADMIN_EMAILS=

# ---------- Capacity ----------
MAX_RUNNING_TENANTS=20
TENANT_IDLE_MINUTES=20
TENANT_DISK_MB=2048
TENANT_MEMORY_MB=768
